{
  "name": "governor-discord-alerts",
  "version": "1.0.0",
  "description": "",
  "main": "pulumi.ts",
  "scripts": {
    "audit": "pnpm audit --audit-level moderate --json",
    "audit:function": "node scripts/check-function-install.mjs --audit",
    "build": "cd function && pnpm run build",
    "install:function:check": "node scripts/check-function-install.mjs",
    "lint": "cd function && pnpm run lint",
    "lint:check": "cd function && pnpm run lint:check",
    "test": "cd function && pnpm run test",
    "validate:pnpm": "pnpm install --frozen-lockfile && pnpm run audit && pnpm run install:function:check && pnpm run audit:function"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@pulumi/gcp": "^9.37.1",
    "@pulumi/pulumi": "^3.274.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": "use-pnpm",
    "pnpm": ">=11.28.9 <12",
    "bun": "use-pnpm",
    "yarn": "use-pnpm"
  },
  "packageManager": "pnpm@11.28.9"
}
